@page "/"
@rendermode InteractiveServer
@using System.Net
@using System.Text
@using System.Text.Json
@using global::WebEditor.Models
@using global::WebEditor.Services
@inject IArticleService ArticleService
@inject Microsoft.Extensions.Options.IOptions<ArticleServiceOptions> ArticleServiceOptions

<PageTitle>Home</PageTitle>

<h1>Articles</h1>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <p><strong>Error:</strong> @_loadError</p>
}
else if (_articles is null)
{
    <p><em>Loading articles...</em></p>
}
else if (_articles.Count == 0)
{
    <p>No articles found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Article #</th>
                <th>Title</th>
                <th>Author</th>
                <th>Updated Date</th>
                <th>Reference Count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var article in _articles)
            {
                <tr class="@GetRowClass(article)" @onclick="() => SelectArticleAsync(article.Id)" style="cursor: pointer;">
                    <td>@article.Id</td>
                    <td>@article.Title</td>
                    <td>@(article.Author?.ToString() ?? "-")</td>
                    <td>@article.DateUpdated.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@article.ReferCount</td>
                </tr>
            }
        </tbody>
    </table>

    @if (_isLoadingDetails)
    {
        <p><em>Loading selected article...</em></p>
    }
    else if (!string.IsNullOrWhiteSpace(_detailError))
    {
        <p><strong>Error:</strong> @_detailError</p>
    }
    else if (_selectedArticle is not null)
    {
        <div class="html-preview">
            <h2>JSON Content</h2>
            <textarea class="json-output" readonly>@_selectedArticleJson</textarea>
        </div>

        <div class="html-preview">
            <h2>HTML Preview</h2>
            <div class="editor">@((MarkupString)_selectedArticlePreviewHtml)</div>
        </div>
    }
}

@code {
    private List<ArticleModel>? _articles;
    private string _loadError = string.Empty;
    private ArticleModel? _selectedArticle;
    private long? _selectedArticleId;
    private string _selectedArticleJson = string.Empty;
    private string _selectedArticlePreviewHtml = string.Empty;
    private bool _isLoadingDetails;
    private string _detailError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tenantId = ArticleServiceOptions.Value.TenantId;
            _articles = await ArticleService.GetArticlesAsync(tenantId == Guid.Empty ? null : tenantId);

            if (_articles.Count > 0)
            {
                await SelectArticleAsync(_articles[0].Id);
            }
        }
        catch (HttpRequestException ex)
        {
            _loadError = ex.Message;
            _articles = [];
        }
    }

    private async Task SelectArticleAsync(long articleId)
    {
        _selectedArticleId = articleId;
        _isLoadingDetails = true;
        _detailError = string.Empty;

        try
        {
            var article = await ArticleService.GetArticleAsync(articleId);
            _selectedArticle = article;
            _selectedArticleJson = PrettyPrintJson(article.Content);
            _selectedArticlePreviewHtml = ConvertContentToHtml(article.Content);
        }
        catch (HttpRequestException ex)
        {
            _selectedArticle = null;
            _selectedArticleJson = string.Empty;
            _selectedArticlePreviewHtml = string.Empty;
            _detailError = ex.Message;
        }
        finally
        {
            _isLoadingDetails = false;
        }
    }

    private string GetRowClass(ArticleModel article)
    {
        return _selectedArticleId == article.Id ? "table-active" : string.Empty;
    }

    private static string PrettyPrintJson(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return string.Empty;
        }

        try
        {
            using var document = JsonDocument.Parse(content);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return content;
        }
    }

    private static string ConvertContentToHtml(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return string.Empty;
        }

        try
        {
            var model = JsonSerializer.Deserialize<DocumentModel>(
                content,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (model?.Blocks is null || model.Blocks.Count == 0)
            {
                return "<p>No content.</p>";
            }

            var builder = new StringBuilder();

            foreach (var block in model.Blocks)
            {
                builder.Append(RenderBlock(block));
            }

            return builder.ToString();
        }
        catch (JsonException)
        {
            return $"<pre>{WebUtility.HtmlEncode(content)}</pre>";
        }
    }

    private static string RenderBlock(DocumentBlock block)
    {
        var blockType = block.Type?.ToLowerInvariant();
        var alignAttribute = BuildAlignmentAttribute(block.Align);

        return blockType switch
        {
            "heading" => RenderHeading(block, alignAttribute),
            "paragraph" => $"<p{alignAttribute}>{RenderRuns(block.Content)}</p>",
            "blockquote" => $"<blockquote{alignAttribute}>{RenderRuns(block.Content)}</blockquote>",
            "list" => RenderList(block, alignAttribute),
            "table" => RenderTable(block),
            "attachment" => RenderAttachment(block, alignAttribute),
            _ => $"<p{alignAttribute}>{RenderRuns(block.Content)}</p>"
        };
    }

    private static string RenderHeading(DocumentBlock block, string alignAttribute)
    {
        var level = block.Level is >= 1 and <= 6 ? block.Level.Value : 1;
        return $"<h{level}{alignAttribute}>{RenderRuns(block.Content)}</h{level}>";
    }

    private static string RenderList(DocumentBlock block, string alignAttribute)
    {
        var tag = block.Ordered == true ? "ol" : "ul";
        var items = block.Items ?? [];
        var builder = new StringBuilder($"<{tag}{alignAttribute}>");

        foreach (var item in items)
        {
            builder.Append($"<li>{RenderRuns(item)}</li>");
        }

        builder.Append($"</{tag}>");

        return builder.ToString();
    }

    private static string RenderTable(DocumentBlock block)
    {
        var rows = block.Rows ?? [];

        if (rows.Count == 0)
        {
            return string.Empty;
        }

        var styleParts = new List<string>();

        if (!string.IsNullOrWhiteSpace(block.Align))
        {
            var align = block.Align.Trim().ToLowerInvariant();

            if (align is "left" or "center" or "right" or "justify")
            {
                styleParts.Add($"text-align:{align}");
            }
        }

        if (block.TableWidth is > 0)
        {
            styleParts.Add($"width:{block.TableWidth.Value}px");
        }

        var tableStyle = styleParts.Count > 0
            ? $" style=\"{string.Join(';', styleParts)};\""
            : string.Empty;

        var builder = new StringBuilder($"<table class=\"table table-bordered\"{tableStyle}><tbody>");

        for (var rowIndex = 0; rowIndex < rows.Count; rowIndex += 1)
        {
            var row = rows[rowIndex];
            builder.Append("<tr>");

            for (var columnIndex = 0; columnIndex < row.Count; columnIndex += 1)
            {
                var cell = row[columnIndex];
                var cellStyles = new List<string>();

                if (block.ColumnWidths is not null
                    && columnIndex < block.ColumnWidths.Count
                    && block.ColumnWidths[columnIndex] > 0)
                {
                    cellStyles.Add($"width:{block.ColumnWidths[columnIndex]}px");
                }

                if (block.RowHeights is not null
                    && rowIndex < block.RowHeights.Count
                    && block.RowHeights[rowIndex] > 0)
                {
                    cellStyles.Add($"height:{block.RowHeights[rowIndex]}px");
                }

                var cellStyle = cellStyles.Count > 0
                    ? $" style=\"{string.Join(';', cellStyles)};\""
                    : string.Empty;

                builder.Append($"<td{cellStyle}>{RenderRuns(cell)}</td>");
            }

            builder.Append("</tr>");
        }

        builder.Append("</tbody></table>");

        return builder.ToString();
    }

    private static string RenderAttachment(DocumentBlock block, string alignAttribute)
    {
        if (string.IsNullOrWhiteSpace(block.Src))
        {
            return string.Empty;
        }

        var src = WebUtility.HtmlEncode(block.Src);
        var alt = WebUtility.HtmlEncode(block.Alt ?? string.Empty);

        return $"<img{alignAttribute} src=\"{src}\" alt=\"{alt}\" />";
    }

    private static string BuildAlignmentAttribute(string? align)
    {
        if (string.IsNullOrWhiteSpace(align))
        {
            return string.Empty;
        }

        var normalized = align.Trim().ToLowerInvariant();

        if (normalized is not ("left" or "center" or "right" or "justify"))
        {
            return string.Empty;
        }

        return $" style=\"text-align:{normalized};\"";
    }

    private static string RenderRuns(List<DocumentRun>? runs)
    {
        if (runs is null || runs.Count == 0)
        {
            return string.Empty;
        }

        var builder = new StringBuilder();

        foreach (var run in runs)
        {
            var rendered = WebUtility.HtmlEncode(run.Text).Replace("\n", "<br />", StringComparison.Ordinal);
            var marks = run.Marks;

            if (marks is not null)
            {
                foreach (var mark in marks)
                {
                    rendered = ApplyMark(rendered, mark);
                }
            }

            builder.Append(rendered);
        }

        return builder.ToString();
    }

    private static string ApplyMark(string content, object mark)
    {
        if (mark is JsonElement element)
        {
            if (element.ValueKind == JsonValueKind.String)
            {
                return ApplyStringMark(content, element.GetString());
            }

            if (element.ValueKind == JsonValueKind.Object)
            {
                return ApplyObjectMark(content, element);
            }
        }

        return mark is string stringMark
            ? ApplyStringMark(content, stringMark)
            : content;
    }

    private static string ApplyStringMark(string content, string? mark)
    {
        return mark?.ToLowerInvariant() switch
        {
            "bold" => $"<strong>{content}</strong>",
            "italic" => $"<em>{content}</em>",
            "underline" => $"<u>{content}</u>",
            _ => content
        };
    }

    private static string ApplyObjectMark(string content, JsonElement mark)
    {
        if (!mark.TryGetProperty("type", out var typeProperty))
        {
            return content;
        }

        if (!string.Equals(typeProperty.GetString(), "link", StringComparison.OrdinalIgnoreCase))
        {
            return content;
        }

        if (!mark.TryGetProperty("href", out var hrefProperty))
        {
            return content;
        }

        var href = WebUtility.HtmlEncode(hrefProperty.GetString() ?? string.Empty);
        return $"<a href=\"{href}\" target=\"_blank\" rel=\"noopener noreferrer\">{content}</a>";
    }
}
