@page "/add-article"
@rendermode InteractiveServer
@using System.Text.Json
@using global::WebEditor.Components
@using global::WebEditor.Models
@using global::WebEditor.Services
@inject IArticleService ArticleService
@inject Microsoft.Extensions.Options.IOptions<ArticleServiceOptions> ArticleServiceOptions

<PageTitle>Add Article</PageTitle>

<h1>Add Article</h1>

<WebEditor @ref="_editor" @bind-Value="_capturedDocumentJson" OnDocumentChanged="HandleDocumentChanged" EnableStorageUploads="true" />

<div class="html-preview">
    <h2>Captured JSON in Blazor (save-ready)</h2>
    <textarea class="json-output" readonly>@_capturedDocumentJson</textarea>
</div>

<p><strong>Document title:</strong> @_documentTitle</p>
<p><strong>Block count:</strong> @_blockCount</p>

@if (!string.IsNullOrWhiteSpace(_parseWarning))
{
    <p><strong>Warning:</strong> @_parseWarning</p>
}

<button type="button" @onclick="SaveArticleAsync" disabled="@_isSaving">Save to ArticleService</button>

@if (!string.IsNullOrWhiteSpace(_saveMessage))
{
    <p><strong>Status:</strong> @_saveMessage</p>
}

@code {
    private global::WebEditor.Components.WebEditor? _editor;
    private string _capturedDocumentJson = string.Empty;
    private string _documentTitle = "Untitled";
    private int _blockCount;
    private bool _isSaving;
    private string _saveMessage = string.Empty;
    private string _parseWarning = string.Empty;
    private long? _savedArticleId;

    private void HandleDocumentChanged(string documentJson)
    {
        try
        {
            var parsed = JsonSerializer.Deserialize<DocumentModel>(
                documentJson,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            _documentTitle = parsed?.Meta?.Title ?? "Untitled";
            _blockCount = parsed?.Blocks?.Count ?? 0;
            _parseWarning = string.Empty;
        }
        catch (JsonException ex)
        {
            _documentTitle = "Untitled";
            _blockCount = 0;
            _parseWarning = $"Editor JSON parse warning: {ex.Message}";
        }
    }

    private async Task SaveArticleAsync()
    {
        _isSaving = true;
        _saveMessage = string.Empty;

        try
        {
            if (ArticleServiceOptions.Value.TenantId == Guid.Empty)
            {
                _saveMessage = "Save failed: ArticleService tenant is empty.";
                return;
            }

            var json = await (_editor ?? throw new InvalidOperationException("Editor is not initialized.")).GetCurrentDocumentAsync();
            var document = JsonSerializer.Deserialize<DocumentModel>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                ?? throw new InvalidOperationException("Editor returned an empty document.");
            var now = DateTime.UtcNow;
            var article = new ArticleCreateModel
            {
                TenantId = ArticleServiceOptions.Value.TenantId,
                Title = document.Meta?.Title ?? "Untitled",
                Author = ArticleServiceOptions.Value.TenantId,
                Content = json,
                DateCreated = now,
                DateUpdated = now,
                Attachments = DocumentAttachments.GetIds(document)
            };

            var saved = await ArticleService.CreateArticleAsync(article);
            _savedArticleId = saved.Id;
            _saveMessage = $"Saved article #{saved.Id} for tenant {saved.TenantId}.";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JsonException or Microsoft.JSInterop.JSException)
        {
            _saveMessage = $"Save failed: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
