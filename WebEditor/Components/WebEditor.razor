@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (ShowComponentTitle)
{
    <h3>@ComponentTitle</h3>
}

<div class="editor-container" @ref="_rootElement">
    @if (ShowToolbar)
    {
        <div class="toolbar">
            <button type="button" data-command="undo" title="Undo" aria-label="Undo">
                <svg class="we-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7H4v5" /><path d="M20 17a8 8 0 0 0-8-8H4" /></svg>
            </button>
            <button type="button" data-command="redo" title="Redo" aria-label="Redo">
                <svg class="we-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 7h5v5" /><path d="M4 17a8 8 0 0 1 8-8h8" /></svg>
            </button>

            <div class="separator"></div>

            <button type="button" data-command="bold" title="Bold"><b>B</b></button>
            <button type="button" data-command="italic" title="Italic"><i>I</i></button>
            <button type="button" data-command="underline" title="Underline"><u>U</u></button>

            <div class="separator"></div>

            <button type="button" data-command="insertUnorderedList" title="Bullet list" aria-label="Bullet list">
                <svg class="we-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="7" r="1.5" /><circle cx="5" cy="12" r="1.5" /><circle cx="5" cy="17" r="1.5" /><path d="M9 7h10M9 12h10M9 17h10" /></svg>
            </button>
            <button type="button" data-command="insertOrderedList" title="Numbered list" aria-label="Numbered list">
                <svg class="we-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h1v2M4 12h2M4 17h2" /><path d="M9 7h10M9 12h10M9 17h10" /></svg>
            </button>

            <div class="separator"></div>

            <button type="button" data-action="insert-table" title="Insert table" aria-label="Insert table">
                <svg class="we-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1" /><path d="M3 10h18M3 14h18M9 5v14M15 5v14" /></svg>
            </button>
            <button type="button" data-action="insert-row" title="Insert row">Row+</button>
            <button type="button" data-action="remove-row" title="Remove row">Row-</button>
            <button type="button" data-action="insert-column" title="Insert column">Col+</button>
            <button type="button" data-action="remove-column" title="Remove column">Col-</button>

            <div class="separator"></div>

            <button type="button" data-block="H1" title="Heading 1">H1</button>
            <button type="button" data-block="H2" title="Heading 2">H2</button>
            <button type="button" data-block="H3" title="Heading 3">H3</button>

            <div class="separator"></div>

            <button type="button" data-command="justifyLeft" title="Align left">Left</button>
            <button type="button" data-command="justifyCenter" title="Align center">Center</button>
            <button type="button" data-command="justifyRight" title="Align right">Right</button>
            <button type="button" data-command="justifyFull" title="Justify">Justify</button>

            <div class="separator"></div>

            <button type="button" data-action="create-link" title="Insert link" aria-label="Insert link">
                <svg class="we-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a4 4 0 0 0 6 0l2-2a4 4 0 0 0-6-6l-1 1" /><path d="M14 11a4 4 0 0 0-6 0l-2 2a4 4 0 0 0 6 6l1-1" /></svg>
            </button>
            <button type="button" data-action="edit-link" title="Edit selected link" aria-label="Edit selected link">
                <svg class="we-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a4 4 0 0 0 6 0l2-2a4 4 0 0 0-6-6l-1 1" /><path d="M14 11a4 4 0 0 0-6 0l-2 2a4 4 0 0 0 6 6l1-1" /><path d="M4 20l4-1 9-9-3-3-9 9-1 4z" /></svg>
            </button>
            <button type="button" data-action="remove-link" title="Remove selected link" aria-label="Remove selected link">
                <svg class="we-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a4 4 0 0 0 6 0l2-2a4 4 0 0 0-6-6l-1 1" /><path d="M14 11a4 4 0 0 0-6 0l-2 2a4 4 0 0 0 6 6l1-1" /><path d="M4 4l16 16" /></svg>
            </button>
            <button type="button" data-action="clear-formatting" title="Clear formatting" aria-label="Clear formatting">
                <svg class="we-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h16" /><path d="M7 4h8l-2 6h-4z" /><path d="M6 6l12 12" /></svg>
            </button>
        </div>
    }

    <div data-role="editor" class="editor" contenteditable="true"></div>

    @if (ShowBuiltInOutputs)
    {
        <div class="html-preview">
            <h2>HTML Output</h2>
            <textarea class="html-output" data-role="html-output" readonly></textarea>
        </div>

        <div class="html-preview">
            <h2>Document JSON Output</h2>
            <textarea class="json-output" data-role="json-output" readonly></textarea>
        </div>
    }
</div>

@code {
    private const string DefaultEditorHtml = "<h1>Article title</h1><p>Start typing your article...</p>";

    private ElementReference _rootElement;
    private DotNetObjectReference<WebEditor>? _dotNetRef;

    [Parameter]
    public string? ComponentTitle { get; set; } = "WebEditor";

    [Parameter]
    public bool ShowComponentTitle { get; set; }

    [Parameter]
    public bool ShowToolbar { get; set; } = true;

    [Parameter]
    public bool ShowBuiltInOutputs { get; set; }

    [Parameter]
    public string? InitialHtml { get; set; }

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnDocumentChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        var initialHtml = string.IsNullOrWhiteSpace(InitialHtml) ? DefaultEditorHtml : InitialHtml;

        await JS.InvokeVoidAsync("webEditorInterop.init", _rootElement, _dotNetRef, initialHtml);
    }

    [JSInvokable]
    public async Task HandleDocumentChanged(string documentJson)
    {
        Value = documentJson;

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(documentJson);
        }

        if (OnDocumentChanged.HasDelegate)
        {
            await OnDocumentChanged.InvokeAsync(documentJson);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("webEditorInterop.dispose", _rootElement);
        }
        catch (JSDisconnectedException)
        {
        }

        _dotNetRef?.Dispose();
    }
}
