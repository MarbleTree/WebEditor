@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (ShowComponentTitle)
{
    <h3>@ComponentTitle</h3>
}

<div class="editor-container" @ref="_rootElement">
    @if (ShowToolbar)
    {
        <div class="toolbar">
            <button type="button" data-command="undo" title="Undo" aria-label="Undo" class="toolbar-text">Undo</button>
            <button type="button" data-command="redo" title="Redo" aria-label="Redo" class="toolbar-text">Redo</button>

            <div class="separator"></div>

            <button type="button" data-command="bold" title="Bold" aria-label="Bold" class="toolbar-label">B</button>
            <button type="button" data-command="italic" title="Italic" aria-label="Italic" class="toolbar-label toolbar-italic">I</button>
            <button type="button" data-command="underline" title="Underline" aria-label="Underline" class="toolbar-label toolbar-underline">U</button>

            <div class="separator"></div>

            <button type="button" data-command="insertUnorderedList" title="Bullet list" aria-label="Bullet list" class="toolbar-label">*</button>
            <button type="button" data-command="insertOrderedList" title="Numbered list" aria-label="Numbered list" class="toolbar-label">1.</button>

            <div class="separator"></div>

            <button type="button" data-action="insert-table" title="Insert table" aria-label="Insert table" class="toolbar-text">Table ▾</button>
            <button type="button" data-action="insert-row" title="Insert row" aria-label="Insert row" class="toolbar-label">R+</button>
            <button type="button" data-action="remove-row" title="Remove row" aria-label="Remove row" class="toolbar-label">R-</button>
            <button type="button" data-action="insert-column" title="Insert column" aria-label="Insert column" class="toolbar-label">C+</button>
            <button type="button" data-action="remove-column" title="Remove column" aria-label="Remove column" class="toolbar-label">C-</button>

            <div class="separator"></div>

            <button type="button" data-block="H1" title="Heading 1" aria-label="Heading 1" class="toolbar-label">H1</button>
            <button type="button" data-block="H2" title="Heading 2" aria-label="Heading 2" class="toolbar-label">H2</button>
            <button type="button" data-block="H3" title="Heading 3" aria-label="Heading 3" class="toolbar-label">H3</button>

            <div class="separator"></div>

            <button type="button" data-command="justifyLeft" title="Align left" aria-label="Align left" class="toolbar-label">L</button>
            <button type="button" data-command="justifyCenter" title="Align center" aria-label="Align center" class="toolbar-label">C</button>
            <button type="button" data-command="justifyRight" title="Align right" aria-label="Align right" class="toolbar-label">R</button>
            <button type="button" data-command="justifyFull" title="Justify" aria-label="Justify" class="toolbar-label">J</button>

            <div class="separator"></div>

            <button type="button" data-action="create-link" title="Insert link" aria-label="Insert link" class="toolbar-text">Link</button>
            <button type="button" data-action="edit-link" title="Edit selected link" aria-label="Edit selected link" class="toolbar-text">Edit</button>
            <button type="button" data-action="remove-link" title="Remove selected link" aria-label="Remove selected link" class="toolbar-text">Unlk</button>
            <button type="button" data-action="clear-formatting" title="Clear formatting" aria-label="Clear formatting" class="toolbar-text">Clear</button>
        </div>
    }

    <div data-role="editor" class="editor" contenteditable="true"></div>

    @if (ShowBuiltInOutputs)
    {
        <div class="html-preview">
            <h2>HTML Output</h2>
            <textarea class="html-output" data-role="html-output" readonly></textarea>
        </div>

        <div class="html-preview">
            <h2>Document JSON Output</h2>
            <textarea class="json-output" data-role="json-output" readonly></textarea>
        </div>
    }
</div>

@code {
    private const string DefaultEditorHtml = "<h1>Article title</h1><p>Start typing your article...</p>";

    private ElementReference _rootElement;
    private DotNetObjectReference<WebEditor>? _dotNetRef;

    [Parameter]
    public string? ComponentTitle { get; set; } = "WebEditor";

    [Parameter]
    public bool ShowComponentTitle { get; set; }

    [Parameter]
    public bool ShowToolbar { get; set; } = true;

    [Parameter]
    public bool ShowBuiltInOutputs { get; set; }

    [Parameter]
    public string? InitialHtml { get; set; }

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnDocumentChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        var initialHtml = string.IsNullOrWhiteSpace(InitialHtml) ? DefaultEditorHtml : InitialHtml;

        await JS.InvokeVoidAsync("webEditorInterop.init", _rootElement, _dotNetRef, initialHtml);
    }

    [JSInvokable]
    public async Task HandleDocumentChanged(string documentJson)
    {
        Value = documentJson;

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(documentJson);
        }

        if (OnDocumentChanged.HasDelegate)
        {
            await OnDocumentChanged.InvokeAsync(documentJson);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("webEditorInterop.dispose", _rootElement);
        }
        catch (JSDisconnectedException)
        {
        }

        _dotNetRef?.Dispose();
    }
}
